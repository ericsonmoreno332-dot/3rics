# Hora límite para considerar tardanza (HH:MM:SS)
TARDANZA_HORA=08:00:00

# Carpeta pública para URLs de fotos (relativa a APP_URL)
UPLOAD_MAX_MB=2

# Configuración API DNI (ApiInti)
DNI_API_URL=https://app.apiinti.dev/api/v1/dni/
