DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistema_practicantes
DB_USER=root
DB_PASS=

APP_URL=http://localhost/REGIS/public

# Habilitar en php.ini: extension=gd, extension=mysqli, extension=pdo_mysql, extension=zip (necesarios para PDF/XLSX/QR local).

# Servicio de imagen QR si Endroid no puede generar PNG (sin gd).
QR_IMAGE_SERVICE=https://api.qrserver.com/v1/create-qr-code/?size=280x280&data=
TIMEZONE=America/Lima

# Hora límite para considerar tardanza (HH:MM:SS)
TARDANZA_HORA=08:15:00

# Carpeta pública para URLs de fotos (relativa a APP_URL)
UPLOAD_MAX_MB=2
