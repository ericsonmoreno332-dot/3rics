{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Development Server",
      "type": "shell",
      "command": "php",
      "args": ["-S", "localhost:3000", "-t", "public"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Development Server.*started",
          "endsPattern": "^.*Development Server.*started"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
